{
    "name": "juicebox/apistacker",
    "description": "Juicebox starter pack for an API driven application",
    "version": "2.1.0",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Juicebox\\Apistacker\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Juicebox\\Apistacker\\ApistackerServiceProvider"
            ],
            "aliases": {
                "Apistacker": "Juicebox\\Apistacker\\Apistacker"
            }
        }
    },
    "authors": [
        {
            "name": "Robert Lim",
            "email": "robert@juicebox.com.au"
        },
        {
            "name": "Azka Secio",
            "email": "azka@juicebox.co.id"
        }
    ],
    "minimum-stability": "dev"
}
